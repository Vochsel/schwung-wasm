  "component_type": "sound_generator",
  "category_dir": "sound_generators",
  "sources": [
    "src/maze-voice/dsp/maze_voice.c"
  ],
  "include": [
    "src/include"
  ],
  "defines": [
    "OVERSAMPLE=2"
  ],
  "cflags": [
    "-ffast-math",
    "-fvisibility=hidden"
  ],
  "cxx": false,
  "assets": [
    "src/maze-voice/module.json",
