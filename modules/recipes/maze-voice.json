    {
      "from": "src/maze-voice/web_ui.html",
      "optional": true
    }
  ],
  "so_name": "dsp.so",
  "upstream_build": "scripts/build.sh: gcc -shared -fPIC -O2 -ffast-math -fvisibility=hidden -DOVERSAMPLE=2 -Isrc/include src/maze-voice/dsp/maze_voice.c; dist/maze-voice/{dsp.so,module.json,help.json,web_ui.html}"
}
