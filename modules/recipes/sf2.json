  "defines": [
    "NDEBUG"
  ],
  "cflags": [],
  "cxx": false,
  "pre_build": [
    "mkdir -p .wasm-demo && python3 /w/modules/demo/gen_demo_sf2.py .wasm-demo/schwung-wasm-demo.sf2"
  ],
  "assets": [
    "src/module.json",
    "src/ui.js",
    {
      "from": "src/help.json",
      "optional": true
    },
    {
      "mkdir": "soundfonts"
    },
    {
      "from": ".wasm-demo/schwung-wasm-demo.sf2",
      "to": "soundfonts/schwung-wasm-demo.sf2"
    }
  ],
  "so_name": "dsp.so",
  "demo_content": "soundfonts/schwung-wasm-demo.sf2 generated by modules/demo/gen_demo_sf2.py (original, CC0-1.0); the module scans <module_dir>/soundfonts",
  "upstream_build": "scripts/build.sh: gcc -O3 -DNDEBUG FluidLite src/*.c (17 files, no vorbis) -I fluidlite/include -I fluidlite/src + sf2_plugin.c -shared; dist/sf2/{module.json,ui.js,dsp.so,help.json,soundfonts/}",
  "per_file_flags": {
    "src/dsp/sf2_plugin.c": [
      "-Wno-error=implicit-function-declaration"
    ]
  },
  "wasm_notes": "sf2_plugin.c calls fluid_synth_all_notes_off without a prototype (an internal FluidLite symbol, int(fluid_synth_t*,int)); GCC only warns, clang errors, so that file gets -Wno-error=implicit-function-declaration. The implicit int() declaration matches the real signature, so the wasm call type is identical."
}
