  "include": [
    "src/dsp"
  ],
  "defines": [],
  "cflags": [],
  "cxxflags": [
    "-std=c++14"
  ],
  "cxx": true,
  "assets": [
    "src/module.json",
    {
      "from": "src/help.json",
      "optional": true
    },
    "src/ui.js"
  ],
  "so_name": "dsp.so",
  "upstream_build": "scripts/build.sh: g++ -O3 -std=c++14 moog_plugin.cpp moog_engine.c (engine compiled AS C++) -Isrc/dsp; dist/moog/{module.json,help.json,ui.js,dsp.so}",
  "per_file_flags": {
    "src/dsp/moog_engine.c": [
      "-x",
      "c++",
      "-std=c++14"
    ]
  }
