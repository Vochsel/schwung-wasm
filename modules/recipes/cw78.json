      "optional": true
    },
    {
      "from": "src/help.json",
      "optional": true
    }
  ],
  "so_name": "dsp.so",
  "upstream_build": "CMakeLists.txt target cr78 (C++14 -O3; cr78_plugin.cpp + cr78_engine.cpp; -Isrc -Isrc/dsp -Isrc/host); dist/cw78/{dsp.so,module.json,ui_chain.js,web_ui.html,help.json}"
}
